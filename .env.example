# Copy to .env and fill in. Then: chmod 600 .env
# Use a dedicated LibreLinkUp follower account, not your main Libre login.

LLU_EMAIL=
LLU_PASSWORD=

# Optional. Leave blank to auto-detect the region (recommended).
# Examples: us, eu, eu2, de, fr, jp, ap, au, ae, ca
LLU_REGION=

# Optional. Only needed if the follower account follows more than one person.
LLU_PATIENT_ID=

# Seconds between polls. Minimum 30. Keep at 60 to avoid rate limiting.
POLL_INTERVAL_SECONDS=60

# SQLite database file.
DB_PATH=./data/readings.db

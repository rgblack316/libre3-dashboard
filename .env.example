# Copy to .env and fill in. Then: chmod 600 .env
# Use a dedicated LibreLinkUp follower account, not your main Libre login.

LLU_EMAIL=
LLU_PASSWORD=

# Optional. Leave blank to auto-detect the region (recommended).
# Examples: us, eu, eu2, de, fr, jp, ap, au, ae, ca
LLU_REGION=

# Optional. Only needed if the follower account follows more than one person.
LLU_PATIENT_ID=

# Password for the /admin settings page. Leave blank to have one generated on first start
# (shown once in `docker compose logs`). Only used the first time; change it later in /admin.
ADMIN_PASSWORD=

# Port the dashboard is published on (host side).
HOST_PORT=8080

# Time zone for quiet hours and the display clock, e.g. America/New_York.
TZ=

# SQLite database file.
DB_PATH=./data/readings.db
